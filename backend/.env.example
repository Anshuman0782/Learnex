# Copy this file to ".env" and fill in real values. NEVER commit the real ".env".

# --- App ---
NODE_ENV=development
PORT=3000

# --- Database (PostgreSQL) ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://lernex:YOUR_DB_PASSWORD@localhost:5432/lernex?schema=public"

# --- Auth (used from Phase 1 onward) ---
# Generate strong random values, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# --- Admin Panel owners (always admin, cannot be revoked; comma-separated) ---
ADMIN_EMAILS=

# --- Cloud media storage (required in production) ---
# Cloudinary dashboard → "API environment variable". Leave empty in dev to use ./uploads.
CLOUDINARY_URL=

# --- Optional TURN relay for calls on strict mobile networks ---
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
