// LERNEX database schema.
// Grows one phase at a time (see backend roadmap). Phase 0 = foundational User only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// The two account types in LERNEX. A brand-new account has no role yet
/// (chosen during onboarding); Mentor is only granted after passing the quiz.
enum UserRole {
  LEARNER
  MENTOR
  /// Can post, comment and chat like anyone else, but earns no XP and is never
  /// ranked. Can become a Learner or Mentor at any time.
  GUEST
}

/// Core account record. Auth-specific fields (password, tokens) are filled in
/// during Phase 1; profile/gamification fields are added in later phases.
model User {
  id           String    @id @default(uuid())
  email        String    @unique
  phone        String?   @unique
  name         String
  // argon2 hash — never the raw password.
  passwordHash String    @map("password_hash")
  // Empty until the user picks a role during onboarding (Phase 2).
  role         UserRole?
  // Collected at signup; drives community recommendations in onboarding.
  dob          String?
  hobby        String?
  // Editable profile fields.
  bio          String?
  handle       String?
  // Public URL of the uploaded profile photo (Phase 5 media pipeline).
  avatarUrl    String?   @map("avatar_url")
  // Expo push token for offline notifications / incoming calls (Phase 8b).
  expoPushToken String?  @map("expo_push_token")

  // Admin Panel access. Checked against the DB on every admin request, so a
  // revoke takes effect immediately. Owners (ADMIN_EMAILS) are always admin.
  isAdmin          Boolean   @default(false) @map("is_admin")
  /// When the user proved they own their email (null = not verified yet).
  emailVerifiedAt  DateTime? @map("email_verified_at")
  adminGrantedAt   DateTime? @map("admin_granted_at")
  adminGrantedById String?   @map("admin_granted_by_id")

  // Hashed refresh token for the current session. Enables rotation + revocation:
  // null = logged out. Never store the raw refresh token.
  hashedRefreshToken String? @map("hashed_refresh_token")
  /// Previous refresh token (accepted briefly after rotation, so a lost
  /// network reply can't log the user out).
  prevRefreshTokenHash String?   @map("prev_refresh_token_hash")
  refreshRotatedAt     DateTime? @map("refresh_rotated_at")

  /// Every skill the member has joined, each with its own role.
  skills       UserSkill[]
  memberships  CommunityMembership[]
  posts        Post[]
  comments     Comment[]
  postLikes    PostLike[]
  commentLikes CommentLike[]
  postSaves    PostSave[]
  postViews    PostView[]
  reposts      Repost[]
  xpEvents     XpEvent[]
  streak       Streak?
  goals        Goal[]
  sessions     PracticeSession[]
  questClaims  QuestClaim[]
  badges       Badge[]
  rewardClaims RewardClaim[]
  seasonStandings SeasonStanding[]
  usageDays    UsageDay[]
  conversationsA Conversation[] @relation("ConversationUserA")
  conversationsB Conversation[] @relation("ConversationUserB")
  messagesSent   Message[]
  eventParticipations EventParticipation[]
  notifications Notification[]
  following      Follow[]        @relation("Following")
  followers      Follow[]        @relation("Followers")
  reportsMade    Report[]        @relation("Reporter")
  reportsAgainst Report[]        @relation("ReportedUser")
  passwordResets PasswordReset[]
  emailCodes     EmailCode[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt      @map("updated_at")
  // Soft-delete: we flag records instead of hard-deleting, so nothing is lost
  // and content can be moderated/restored. Standard across every model.
  deletedAt DateTime? @map("deleted_at")

  @@map("users")
}

/// A hobby-based community/circle. Core fields are columns; the richer display
/// data (tags, avatar stack, stats, seeded mentors/members) is JSON to mirror
/// the app's shape exactly. Real join/leave lives in CommunityMembership.
/// A skill a member has joined (Music, Coding, ...) and their role IN THAT SKILL.
/// One member can be a Learner in one skill and a Mentor in another. The
/// member's main skill is mirrored on User.hobby / User.role. Guests have none.
model UserSkill {
  id       String   @id @default(uuid())
  userId   String   @map("user_id")
  /// Display label, as the member typed/picked it.
  skill    String
  /// Lower-cased label — "music" and "Music" are one skill.
  skillKey String   @map("skill_key")
  role     UserRole

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, skillKey])
  @@index([skillKey, role])
  @@map("user_skills")
}

model Community {
  id          String  @id
  name        String
  category    String
  description String
  iconName    String  @map("icon_name")
  iconBgColor String  @map("icon_bg_color")
  iconColor   String  @map("icon_color")
  isHot       Boolean @default(false) @map("is_hot")
  // Descriptive topic hashtags (metadata, not user data).
  tags        Json
  // The user who created this circle (null for the original seeded ones).
  createdById String? @map("created_by_id")
  // Optional uploaded group photo/logo.
  avatarUrl   String? @map("avatar_url")
  // Who may post to this circle: everyone or admins only.
  postPolicy  CommunityPostPolicy @default(ALL) @map("post_policy")

  // Real membership drives member/mentor counts — nothing is fabricated.
  memberships CommunityMembership[]
  postLinks   PostCommunity[]
  events      CommunityEvent[]

  createdAt DateTime @default(now()) @map("created_at")

  @@index([category])
  @@map("communities")
}

/// A member's role within a circle.
enum CommunityRole {
  ADMIN
  MEMBER
}

/// Who may post to a circle.
enum CommunityPostPolicy {
  ALL
  ADMINS
}

/// A skill/topic tile, grouped by category (the user's hobby).
model Skill {
  id          String  @id
  name        String
  category    String
  iconName    String  @map("icon_name")
  iconBgColor String  @map("icon_bg_color")
  iconColor   String  @map("icon_color")
  topicsCount Int     @map("topics_count")
  badge       String?

  @@index([category])
  @@map("skills")
}

/// Real membership: which user has joined which community.
model CommunityMembership {
  id          String        @id @default(uuid())
  userId      String        @map("user_id")
  communityId String        @map("community_id")
  role        CommunityRole @default(MEMBER)
  joinedAt    DateTime      @default(now()) @map("joined_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([userId, communityId])
  @@index([userId])
  @@map("community_memberships")
}

enum PostType {
  TEXT
  VIDEO
  AUDIO
  IMAGE
  CRITIQUE_REQUEST
}

/// A practice post (text/video/critique request). Public posts are visible to
/// everyone; private posts are visible ONLY to their author (enforced in queries).
model Post {
  id             String   @id @default(uuid())
  authorId       String   @map("author_id")
  content        String
  postType       PostType @map("post_type")
  isPrivate      Boolean  @default(false) @map("is_private")
  title          String?
  tags           Json
  focusArea      String?  @map("focus_area")
  // Uploaded media (Phase 5). videoUrl = the actual clip; videoThumbnail = its poster
  // image (also used as the poster for AUDIO posts); videoDuration = human duration.
  videoUrl       String?  @map("video_url")
  videoThumbnail String?  @map("video_thumbnail")
  videoDuration  String?  @map("video_duration")
  // Audio posts (voice takes). audioUrl = the actual audio clip.
  audioUrl       String?  @map("audio_url")
  // Photo posts: 1–5 uploaded image URLs (shown as a swipeable carousel).
  imageUrls      Json?    @map("image_urls")
  // Scheduled publish time. When set in the future, the post is hidden from
  // everyone except its author until this moment passes.
  scheduledAt    DateTime? @map("scheduled_at")
  // Short/reel: under 60s vertical media shown in the Reels feed.
  isShort        Boolean  @default(false) @map("is_short")
  viewsCount     Int      @default(0) @map("views_count")
  // Moderation: hidden from feeds by a moderator (distinct from author deletedAt).
  isHidden       Boolean  @default(false) @map("is_hidden")
  // Discussion card background (whitelisted palette key; null = default).
  bgStyle        String?  @map("bg_style")
  /// The skill this post belongs to (one of the author's skills). XP, comment
  /// roles and critique rights on this post all follow this skill.
  skill          String?

  author      User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  communities PostCommunity[]
  comments    Comment[]
  likes       PostLike[]
  saves       PostSave[]
  views       PostView[]
  reposts     Repost[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt      @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([authorId])
  @@index([isPrivate, createdAt])
  @@index([isShort, createdAt])
  @@map("posts")
}

/// Links a post to the communities it was shared into (a post can target several).
model PostCommunity {
  postId      String @map("post_id")
  communityId String @map("community_id")

  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@id([postId, communityId])
  @@index([communityId])
  @@map("post_communities")
}

/// A comment or a mentor critique on a post. Mentor critiques (isMentorCritique)
/// may only be created by users with the MENTOR role (enforced server-side).
model Comment {
  id                     String   @id @default(uuid())
  postId                 String   @map("post_id")
  authorId               String   @map("author_id")
  text                   String
  isMentorCritique       Boolean  @default(false) @map("is_mentor_critique")
  mentorRating           Int?     @map("mentor_rating")
  critiqueFocus          String?  @map("critique_focus")
  videoCritiqueThumbnail String?  @map("video_critique_thumbnail")
  videoCritiqueDuration  String?  @map("video_critique_duration")
  videoCritiqueTitle     String?  @map("video_critique_title")
  isHidden               Boolean  @default(false) @map("is_hidden")

  post   Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes  CommentLike[]

  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([postId])
  @@map("comments")
}

model PostLike {
  postId String @map("post_id")
  userId String @map("user_id")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@id([postId, userId])
  @@index([userId])
  @@map("post_likes")
}

model CommentLike {
  commentId String @map("comment_id")
  userId    String @map("user_id")

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@id([commentId, userId])
  @@index([userId])
  @@map("comment_likes")
}

model PostSave {
  postId String @map("post_id")
  userId String @map("user_id")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@id([postId, userId])
  @@index([userId])
  @@map("post_saves")
}

/// One row per (viewer, post): a unique, permanent view. viewsCount on Post is
/// the count of these — so replays by the same user never inflate the number.
model PostView {
  postId String @map("post_id")
  userId String @map("user_id")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@id([postId, userId])
  @@index([userId])
  @@map("post_views")
}

/// A repost (re-share) of a post by a user. Shows on the reposter's profile and
/// is counted on the original post. Unique per (user, post).
model Repost {
  postId String @map("post_id")
  userId String @map("user_id")

  // Optional caption the reposter wrote, and an optional circle they tagged the
  // repost into (used to suggest that circle to viewers).
  caption     String? @db.Text
  communityId String? @map("community_id")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@id([postId, userId])
  @@index([userId])
  @@index([createdAt])
  @@map("reposts")
}

/// Where an XP award came from.
enum XpSource {
  SESSION
  POST
  CRITIQUE_RECEIVED
  CRITIQUE_GIVEN
  DAILY_CHECKIN
  GOAL_COMPLETE
  QUEST
  STREAK_MILESTONE
  EVENT
  COMMENT
  LIKE_RECEIVED
  ADMIN_ADJUSTMENT
  CUSTOM_RULE
}

/// The XP economy, one row per earnable action. Each rule listens to a `trigger`
/// (a real app event such as 'reel.published'); every active rule on a trigger
/// pays out when it fires. `isCore` rules are fixed by the platform (re-asserted
/// from code on boot, not editable). Built-in rules can be tuned by admins, and
/// admins can add their own rules on any trigger.
model XpRule {
  key         String  @id // e.g. 'CONTENT_PUBLISHED' or 'CUSTOM_ab12cd'
  trigger     String  @default("") // e.g. 'post.published'
  title       String
  description String
  role        String // who can earn it: 'Learner' | 'Mentor' | 'Both'
  category    String // 'Consistency' | 'Practice' | 'Community' | 'Mentoring' | 'Milestones'
  xp          Int
  // Max times this rule can pay out per UTC day (null = no cap).
  dailyCap    Int?    @map("daily_cap")
  isCore      Boolean @default(false) @map("is_core")
  isActive    Boolean @default(true) @map("is_active")
  sortOrder   Int     @default(0) @map("sort_order")
  createdById String? @map("created_by_id") // set for admin-created rules

  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([trigger])
  @@map("xp_rules")
}

/// Seconds a user spent in the app per UTC day (from foreground heartbeats).
/// Powers the admin "time spent" statistics.
model UsageDay {
  userId  String @map("user_id")
  day     String // 'YYYY-MM-DD'
  seconds Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([userId, day])
  @@index([day])
  @@map("usage_days")
}

/// Append-only XP ledger. Total XP, levels, stats, leaderboards and seasons all
/// derive from these rows. `dedupeKey` makes awards idempotent (never double-count).
model XpEvent {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  amount    Int
  source    XpSource
  // The XpRule that paid this (null for quests/events/adjustments). Daily caps
  // are counted per rule from this column.
  ruleKey   String?  @map("rule_key")
  dedupeKey String?  @unique @map("dedupe_key")
  /// Which skill earned it (lower-cased key) and the member's role in that
  /// skill at the time — 'Learner' | 'Mentor'. Boards are built from these.
  skill     String?
  role      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([role, skill, createdAt])
  @@index([userId])
  @@index([userId, createdAt])
  @@index([userId, ruleKey, createdAt])
  @@map("xp_events")
}

/// One row per user tracking their practice streak (UTC day based).
model Streak {
  userId        String  @id @map("user_id")
  current       Int     @default(0)
  longest       Int     @default(0)
  lastActiveDay String? @map("last_active_day") // 'YYYY-MM-DD'

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("streaks")
}

/// A learner/mentor practice goal. Only one is active per user at a time.
model Goal {
  id                String    @id @default(uuid())
  userId            String    @map("user_id")
  title             String
  targetSessions    Int       @map("target_sessions")
  targetHours       Float     @map("target_hours")
  targetDate        String?   @map("target_date")
  completedSessions Int       @default(0) @map("completed_sessions")
  completedMinutes  Int       @default(0) @map("completed_minutes")
  dailyReminders    Boolean   @default(true) @map("daily_reminders")
  isActive          Boolean   @default(true) @map("is_active")
  completedAt       DateTime? @map("completed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("goals")
}

/// A logged practice session (feeds the active goal, streak and XP).
model PracticeSession {
  id      String  @id @default(uuid())
  userId  String  @map("user_id")
  goalId  String? @map("goal_id")
  minutes Int     @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("practice_sessions")
}

/// Records that a user claimed a quest for a given period (daily/weekly key),
/// so a quest can only pay out once per period.
model QuestClaim {
  id      String @id @default(uuid())
  userId  String @map("user_id")
  questId String @map("quest_id")
  period  String // 'YYYY-MM-DD' (daily) or 'YYYY-Www' (weekly)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, questId, period])
  @@index([userId])
  @@map("quest_claims")
}

/// An unlocked achievement (once per user per code).
model Badge {
  id     String @id @default(uuid())
  userId String @map("user_id")
  code   String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  awardedAt DateTime @default(now()) @map("awarded_at")

  @@unique([userId, code])
  @@index([userId])
  @@map("badges")
}

/// A monthly competition cycle. Season XP = XpEvents whose createdAt falls in
/// [startsAt, endsAt). Created lazily for the current month if missing.
model Season {
  id       String   @id @default(uuid())
  number   Int      @unique
  title    String
  startsAt DateTime @map("starts_at")
  endsAt   DateTime @map("ends_at")
  // Set once the season has ended and its final standings were snapshotted.
  finalizedAt DateTime? @map("finalized_at")

  rewardClaims RewardClaim[]
  standings    SeasonStanding[]

  createdAt DateTime @default(now()) @map("created_at")

  @@map("seasons")
}

/// Locked final ranking of a finished season (taken once, after the month ends).
/// Monthly resets never lose history, and rewards can be granted against it.
model SeasonStanding {
  id       String @id @default(uuid())
  seasonId String @map("season_id")
  userId   String @map("user_id")
  role     String // 'Learner' | 'Mentor' — separate boards
  rank     Int
  xp       Int

  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  // A member with Learner AND Mentor skills is ranked on both boards.
  @@unique([seasonId, userId, role])
  @@index([seasonId, role, rank])
  @@map("season_standings")
}

/// Reward catalog. Seeded with sensible defaults now; an admin panel will CRUD
/// these later. Eligibility = role match AND the user's season rank within
/// `rankScope` is <= `minRank`.
model SeasonReward {
  id             String  @id
  type           String
  title          String
  subtitle       String
  description    String
  icon           String
  tag            String
  targetRole     String  @map("target_role") // 'Learner' | 'Mentor' | 'Both'
  minRankLabel   String  @map("min_rank_label")
  minRank        Int     @map("min_rank")
  rankScope      String  @map("rank_scope") // 'overall' | 'learner' | 'mentor'
  sampleCode     String? @map("sample_code")
  perks          Json
  gradientColors Json    @map("gradient_colors")
  sortOrder      Int     @default(0) @map("sort_order")
  isActive       Boolean @default(true) @map("is_active")

  claims RewardClaim[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("season_rewards")
}

model RewardClaim {
  id       String @id @default(uuid())
  userId   String @map("user_id")
  rewardId String @map("reward_id")
  seasonId String @map("season_id")
  code     String

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  reward SeasonReward @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  season Season       @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, rewardId, seasonId])
  @@map("reward_claims")
}

/// Community event catalog (seeded now; admin-managed later). Real join/complete
/// lives in EventParticipation; participant counts are computed from it.
/// A circle event / challenge. Created by admins only, runs for exactly 7 days,
/// and pays XP when a member completes a goal that the server verifies from real
/// activity (posts / critiques / comments in the circle after they joined).
model CommunityEvent {
  id             String    @id @default(uuid())
  communityId    String    @map("community_id")
  title          String
  subtitle       String
  description    String
  targetRole     String    @map("target_role") // 'Learner' | 'Mentor' | 'Both'
  category       String // 'challenge' | 'workshop' | 'speed_run' | 'showcase'
  xpReward       Int       @map("xp_reward")
  bonusReward    String?   @map("bonus_reward")
  status         String    @default("active")
  // What completes it: 'SUBMIT_POST' | 'GIVE_CRITIQUES' | 'COMMENT', `goalCount` times.
  goalType       String    @default("SUBMIT_POST") @map("goal_type")
  goalCount      Int       @default(1) @map("goal_count")
  // For SUBMIT_POST: 'any' | 'video' | 'reel' | 'audio' | 'discussion'.
  contentKind    String    @default("any") @map("content_kind")
  startsAt       DateTime  @default(now()) @map("starts_at")
  endsAt         DateTime? @map("ends_at")
  createdById    String?   @map("created_by_id")
  // Voting phase: members vote to join until this time; only voters can play.
  // Activity counts from votingEndsAt until endsAt (the live phase).
  votingEndsAt   DateTime? @map("voting_ends_at")
  // Separate challenge tracks: [{ id, type, target, kind? }] + XP per track.
  learnerTasks   Json?     @map("learner_tasks")
  mentorTasks    Json?     @map("mentor_tasks")
  learnerXp      Int?      @map("learner_xp")
  mentorXp       Int?      @map("mentor_xp")
  cancelledAt    DateTime? @map("cancelled_at") // not enough voters
  settledAt      DateTime? @map("settled_at") // final XP paid out
  bannerGradient Json      @map("banner_gradient")
  icon           String
  requirements   Json

  community      Community            @relation(fields: [communityId], references: [id], onDelete: Cascade)
  participations EventParticipation[]

  createdAt DateTime @default(now()) @map("created_at")

  @@index([communityId])
  @@index([endsAt])
  @@map("community_events")
}

model EventParticipation {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  eventId     String    @map("event_id")
  completedAt DateTime? @map("completed_at")
  // XP actually paid so far (0 for the event's creator — see anti-cheat rules).
  xpAwarded   Int       @default(0) @map("xp_awarded")
  // The track this voter plays ('Learner' | 'Mentor'), fixed when they vote.
  role        String    @default("Learner")
  // Last computed completion % (cached for the participants board).
  progressPct Int       @default(0) @map("progress_pct")

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  event CommunityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now()) @map("joined_at")

  @@unique([userId, eventId])
  @@index([eventId])
  @@map("event_participations")
}

enum NotificationType {
  COMMENT
  CRITIQUE
  LIKE
  EVENT
  SYSTEM
  FOLLOW
  REPOST
  CALL
  ANNOUNCEMENT
}

/// In-app notification delivered live over WebSocket and stored for the bell list.
model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  body      String
  actorName String?          @map("actor_name")
  postId    String?          @map("post_id")
  read      Boolean          @default(false)
  // Who triggered it (for tap-to-open profile) and where a tap should go.
  actorId   String?          @map("actor_id")
  data      Json?
  // One notification per key per user (e.g. "like:<post>:<actor>") so
  // like/unlike toggling can't spam the recipient.
  dedupeKey String?          @map("dedupe_key")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, dedupeKey])
  @@index([userId, read])
  @@index([userId, createdAt])
  @@map("notifications")
}

/// A follow edge: follower → following.
model Follow {
  id          String @id @default(uuid())
  followerId  String @map("follower_id")
  followingId String @map("following_id")

  follower  User @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([followerId, followingId])
  @@index([followingId])
  @@map("follows")
}

enum ReportTargetType {
  POST
  COMMENT
  USER
}

enum ReportStatus {
  OPEN
  REVIEWED
  ACTIONED
  DISMISSED
}

/// A user-submitted report of a post, comment, or user (moderation queue).
model Report {
  id             String           @id @default(uuid())
  reporterId     String           @map("reporter_id")
  targetType     ReportTargetType @map("target_type")
  postId         String?          @map("post_id")
  commentId      String?          @map("comment_id")
  reportedUserId String?          @map("reported_user_id")
  reason         String
  status         ReportStatus     @default(OPEN)

  reporter     User  @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser User? @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([status])
  @@map("reports")
}

/// A short-lived password reset code (hashed). Emailed in production; in dev the
/// code is logged/returned so the flow is testable without an email provider.
model PasswordReset {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  codeHash  String    @map("code_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  /// Wrong guesses so far (the code dies after 5).
  attempts  Int       @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_resets")
}

/// One-time 6-digit codes sent by email (hashed; 15-min expiry; 5 attempts).
model EmailCode {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  /// VERIFY_EMAIL | CHANGE_CONTACT
  purpose   String
  codeHash  String    @map("code_hash")
  /// For CHANGE_CONTACT: the requested new email / phone.
  newEmail  String?   @map("new_email")
  newPhone  String?   @map("new_phone")
  attempts  Int       @default(0)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("email_codes")
}

/// A private 1:1 chat between two users. The pair is stored sorted
/// (userAId < userBId) so there is exactly one conversation per pair.
model Conversation {
  id            String   @id @default(uuid())
  userAId       String   @map("user_a_id")
  userBId       String   @map("user_b_id")
  lastMessageAt DateTime @default(now()) @map("last_message_at")

  userA    User      @relation("ConversationUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB    User      @relation("ConversationUserB", fields: [userBId], references: [id], onDelete: Cascade)
  messages Message[]

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userAId, userBId])
  @@index([userAId, lastMessageAt])
  @@index([userBId, lastMessageAt])
  @@map("conversations")
}

/// A chat message. `readAt` is set when the recipient opens the conversation.
model Message {
  id             String    @id @default(uuid())
  conversationId String    @map("conversation_id")
  senderId       String    @map("sender_id")
  text           String    @db.Text
  readAt         DateTime? @map("read_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([conversationId, createdAt])
  @@index([conversationId, senderId, readAt])
  @@map("messages")
}

/// Admin-composed notification sent to an audience now or at a scheduled time.
model Broadcast {
  id          String    @id @default(uuid())
  title       String
  body        String
  /// ALL | LEARNERS | MENTORS | CIRCLE | USERS
  audience    String
  communityId String?   @map("community_id")
  userIds     Json?     @map("user_ids")
  scheduledAt DateTime? @map("scheduled_at")
  /// PENDING | SENDING | SENT | CANCELLED | FAILED
  status      String    @default("PENDING")
  recipients  Int       @default(0)
  pushed      Int       @default(0)
  createdById String    @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  sentAt      DateTime? @map("sent_at")

  @@index([status, scheduledAt])
  @@map("broadcasts")
}
